# =====================================================================
# MADIDI JUNGLE ECOLODGE - ENVIRONMENT VARIABLES
# =====================================================================

# Environment mode: development | staging | production
ENVIRONMENT=production

# Backend FastAPI settings
PROJECT_NAME="Madidi Jungle Ecolodge API"
VERSION="2.0.0"
API_V1_STR="/api"

# PostgreSQL Database Connection
POSTGRES_USER=postgres
POSTGRES_PASSWORD=madidi_secure_pass_2026
POSTGRES_DB=madidi_jungle
DATABASE_URL=postgresql+asyncpg://postgres:madidi_secure_pass_2026@localhost:5432/madidi_jungle

# WhatsApp Concierge Hotline (Official Rurrenabaque Coordination)
WHATSAPP_PHONE_NUMBER=59172288339
WHATSAPP_DEFAULT_AGENT="Jaime - Guía Nativo Madidi"

# Frontend Next.js Public URLs
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security and CORS
CORS_ORIGINS=["https://madidijungle.com","https://www.madidijungle.com","http://localhost:3000"]
